---
import { portfolio } from "../data/portfolio";
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout title="Projects" canonicalPath="/projects" image={portfolio.imagePath}>
	<main class="page">
		<header>
			<p class="eyebrow">projects</p>
			<h1>Selected Work</h1>
			<p>Portfolio entries and project notes for {portfolio.name}.</p>
			<nav>
				<a href="/">Terminal</a>
				<a href="/resume">Resume</a>
				<a href="/colophon">Colophon</a>
			</nav>
		</header>

		<section class="list">
			{
				portfolio.projects.map((project) => (
					<article class="panel">
						<h2>{project.name}</h2>
						<p>{project.summary}</p>
						<p>{project.technologies.join(" · ")}</p>
						{project.url && <a href={project.url}>Open project</a>}
					</article>
				))
			}
		</section>
	</main>
</BaseLayout>
