---
import {
	agentGuidancePath,
	agentsTxtPath,
	colophonPath,
	resumePdfPath,
	resumeTextPath,
	siteDescription,
	skills,
} from "../agentDiscovery";
import TerminalExperience from "../components/TerminalExperience.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;

const name = "Adam Burmister";
const imagePath = "/adam-burmister.png";
---

<BaseLayout terminalOnly canonicalPath="/" image={imagePath}>
	<TerminalExperience />
	<main class="visually-hidden">
		<h1>{name}</h1>
		<p>{siteDescription}</p>
		<a href={resumePdfPath}>Download Adam Burmister's resume PDF</a>
		<a href={resumeTextPath}>Read Adam Burmister's resume as text</a>
		<a href={colophonPath}>Colophon</a>
		<a href={agentGuidancePath}>LLM guidance</a>
		<a href={agentsTxtPath}>Agent guidance</a>
		<section>
			<h2>Skills</h2>
			<ul>
				{skills.map((skill) => <li>{skill}</li>)}
			</ul>
		</section>
	</main>
	<noscript>
		<main class="page">
			<header>
				<p class="eyebrow">Senior Frontend Engineer</p>
				<h1>{name}</h1>
				<p>{siteDescription}</p>
				<nav>
					<a href={resumePdfPath}>Resume PDF</a>
					<a href={resumeTextPath}>Text Resume</a>
					<a href={colophonPath}>Colophon</a>
					<a href={agentGuidancePath}>LLM Guidance</a>
				</nav>
			</header>
			<section>
				<h2>Skills</h2>
				<ul>
					{skills.map((skill) => <li>{skill}</li>)}
				</ul>
			</section>
		</main>
	</noscript>
	<script is:inline>
		(() => {
			const modelContext = navigator.modelContext;

			if (typeof modelContext?.provideContext !== "function") {
				return;
			}

			modelContext.provideContext({
				tools: [
					{
						name: "get_profile_summary",
						description: "Return a concise profile summary for Adam Burmister.",
						inputSchema: {
							type: "object",
							properties: {},
							additionalProperties: false,
						},
						execute: async () => ({
							name: "Adam Burmister",
							role: "Senior Frontend Engineer",
							description:
								"Adam Burmister is a senior frontend engineer focused on React, TypeScript, design systems, SaaS UX, polished web products and practical full-stack delivery.",
							resumePdf: "/cv.pdf",
							resumeText: "/resume.txt",
						}),
					},
					{
						name: "get_guestbook_entries",
						description: "Return the latest public BBS guestbook entries.",
						inputSchema: {
							type: "object",
							properties: {},
							additionalProperties: false,
						},
						execute: async () => {
							const response = await fetch("/api/guestbook");
							return response.json();
						},
					},
				],
			});
		})();
	</script>
</BaseLayout>
