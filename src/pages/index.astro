---
import TerminalExperience from "../components/TerminalExperience.astro";
import { portfolio } from "../data/portfolio";
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout terminalOnly canonicalPath="/" image={portfolio.imagePath}>
	<TerminalExperience />
	<main class="visually-hidden">
		<h1>{portfolio.name}</h1>
		<p>{portfolio.description}</p>
		<a href={portfolio.resumePdfPath}>Download Adam Burmister's resume PDF</a>
		<a href="/resume">Resume</a>
		<a href="/projects">Projects</a>
		<a href="/colophon">Colophon</a>
		<section>
			<h2>Skills</h2>
			<ul>
				{portfolio.skills.map((skill) => <li>{skill}</li>)}
			</ul>
		</section>
	</main>
</BaseLayout>
