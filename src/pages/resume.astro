---
import { portfolio } from "../data/portfolio";
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout title="Resume" canonicalPath="/resume" image={portfolio.imagePath}>
	<main class="page">
		<header>
			<p class="eyebrow">resume</p>
			<h1>{portfolio.name}</h1>
			<p>{portfolio.description}</p>
			<nav>
				<a href="/">Terminal</a>
				<a href="/projects">Projects</a>
				<a href="/colophon">Colophon</a>
				<a class="button-link" href={portfolio.resumePdfPath}>Download PDF</a>
			</nav>
		</header>

		<section>
			<h2>Experience</h2>
			<div class="list">
				{
					portfolio.experience.map((entry) => (
						<article class="panel">
							<h3>{entry.role}</h3>
							<p>{entry.company} · {entry.period} · {entry.location}</p>
							<p>{entry.summary}</p>
						</article>
					))
				}
			</div>
		</section>

		<section>
			<h2>Skills</h2>
			<ul>
				{portfolio.skills.map((skill) => <li>{skill}</li>)}
			</ul>
		</section>
	</main>
</BaseLayout>
