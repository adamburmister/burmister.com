---
interface Props {
	title?: string;
	description?: string;
	canonicalPath?: string;
	image?: string;
	terminalOnly?: boolean;
}

const siteName = "Adam Burmister";
const siteTitle = "Full Stack Engineer";
const siteDescription =
	"Adam Burmister is a full-stack engineer focused on practical systems, polished web products, TypeScript, React, Node.js, and cloud infrastructure.";

const {
	title = `${siteName} - ${siteTitle}`,
	description = siteDescription,
	canonicalPath = "/",
	image = "/assets/images/thumbnail.png",
	terminalOnly = false,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, "https://burmister.com").toString();
const pageTitle = title.includes(siteName) ? title : `${title} - ${siteName}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content={siteName} />
		<meta name="theme-color" content="#111416" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/png" href="/adam-burmister.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=VT323&family=Inter:wght@400;600;700&display=swap"
			rel="stylesheet"
		/>
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta
			property="og:image"
			content={new URL(image, "https://burmister.com").toString()}
		/>
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalUrl} />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta
			name="twitter:image"
			content={new URL(image, "https://burmister.com").toString()}
		/>
	</head>
	<body class:list={[terminalOnly && "terminal-only"]}>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: dark;
		--surface: oklch(12% 0.01 185);
		--surface-raised: oklch(17% 0.012 185);
		--text: oklch(91% 0.018 145);
		--muted: oklch(70% 0.018 165);
		--accent: oklch(76% 0.13 148);
		--line: oklch(31% 0.025 170);
		--terminal-bg: oklch(6% 0.01 185);
		font-family: Inter, system-ui, sans-serif;
		background: var(--surface);
		color: var(--text);
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		min-height: 100%;
	}

	body.terminal-only {
		width: 100%;
		height: 100%;
		overflow: hidden;
	}

	a {
		color: var(--accent);
	}

	.page {
		width: min(920px, calc(100% - 32px));
		margin: 0 auto;
		padding: 56px 0 72px;
	}

	.page header {
		margin-bottom: 40px;
	}

	.eyebrow {
		color: var(--accent);
		font-family: VT323, monospace;
		font-size: 1.35rem;
		margin: 0 0 8px;
	}

	h1,
	h2 {
		letter-spacing: 0;
		line-height: 1.05;
	}

	h1 {
		font-size: clamp(2.6rem, 7vw, 5.5rem);
		margin: 0 0 16px;
	}

	h2 {
		font-size: clamp(1.7rem, 4vw, 2.5rem);
		margin: 40px 0 14px;
	}

	p,
	li {
		color: var(--muted);
		font-size: 1rem;
		line-height: 1.7;
		max-width: 72ch;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 24px;
	}

	nav a,
	.button-link {
		border: 1px solid var(--line);
		border-radius: 6px;
		color: var(--text);
		padding: 10px 14px;
		text-decoration: none;
	}

	.list {
		display: grid;
		gap: 18px;
		margin-top: 20px;
	}

	.panel {
		border: 1px solid var(--line);
		border-radius: 8px;
		background: var(--surface-raised);
		padding: 20px;
	}

	.panel h2,
	.panel h3 {
		margin-top: 0;
	}

	.visually-hidden {
		clip: rect(0 0 0 0);
		clip-path: inset(50%);
		height: 1px;
		overflow: hidden;
		position: absolute;
		white-space: nowrap;
		width: 1px;
	}
</style>
