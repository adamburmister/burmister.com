---
import { personJsonLd } from "../agentDiscovery";

interface Props {
	title?: string;
	description?: string;
	canonicalPath?: string;
	image?: string;
	terminalOnly?: boolean;
}

const siteName = "Adam Burmister";
const siteTitle = "Senior Frontend Engineer";
const siteDescription =
	"Adam Burmister is a senior frontend engineer focused on React, TypeScript, design systems, SaaS UX, polished web products and practical full-stack delivery.";

const {
	title = `${siteName} - ${siteTitle}`,
	description = siteDescription,
	canonicalPath = "/",
	image = "/assets/images/thumbnail.png",
	terminalOnly = false,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, "https://burmister.com").toString();
const pageTitle = title.includes(siteName) ? title : `${title} - ${siteName}`;
---

<!doctype html>
<!-- Hey look at you there! You curious human. Source code is at https://github.com/adamburmister/burmister.com -->
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content={siteName} />
		<meta name="theme-color" content="#111416" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/png" href="/adam-burmister.png" />
		<link
			rel="alternate"
			type="text/plain"
			href="/llms.txt"
			title="LLM guidance"
		/>
		<link
			rel="alternate"
			type="text/plain"
			href="/agents.txt"
			title="Agent guidance"
		/>
		<link
			rel="alternate"
			type="text/plain"
			href="/resume.txt"
			title="Text CV/resume"
		/>
		<link
			rel="alternate"
			type="text/plain"
			href="/colophon.txt"
			title="Colophon"
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=VT323&family=Inter:wght@400;600;700&display=swap"
			rel="stylesheet"
		/>
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta
			property="og:image"
			content={new URL(image, "https://burmister.com").toString()}
		/>
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalUrl} />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta
			name="twitter:image"
			content={new URL(image, "https://burmister.com").toString()}
		/>
		<script
			type="application/ld+json"
			set:html={JSON.stringify(personJsonLd)}
		/>
	</head>
	<body class:list={[terminalOnly && "terminal-only"]}>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: dark;
		--surface: oklch(12% 0.01 185);
		--surface-raised: oklch(17% 0.012 185);
		--text: oklch(91% 0.018 145);
		--accent: oklch(76% 0.13 148);
		--terminal-bg: oklch(6% 0.01 185);
		font-family: Inter, system-ui, sans-serif;
		background: var(--surface);
		color: var(--text);
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		min-height: 100%;
	}

	body.terminal-only {
		width: 100%;
		height: 100%;
		overflow: hidden;
	}

	a {
		color: var(--accent);
	}

	.visually-hidden {
		clip: rect(0 0 0 0);
		clip-path: inset(50%);
		height: 1px;
		overflow: hidden;
		position: absolute;
		white-space: nowrap;
		width: 1px;
	}
</style>
