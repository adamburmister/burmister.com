{
	"compatibility_date": "2026-05-03",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "burmister-com",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page"
	},
	"observability": {
		"enabled": true
	}
}