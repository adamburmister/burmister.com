{
  "compatibility_date": "2026-05-03",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "burmister-com",
  "main": "src/worker.ts",
  "durable_objects": {
    "bindings": [
      {
        "name": "GUESTBOOK",
        "class_name": "GuestbookDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GuestbookDurableObject"]
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "b12976588d0d411bba162711ebf6ab4e"
    }
  ]
}
