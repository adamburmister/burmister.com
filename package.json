{
  "name": "burmister-com",
  "version": "1.0.0",
  "description": "Adam Burmister's retro terminal CV and portfolio website",
  "type": "module",
  "scripts": {
    "build-terminal-assets": "node scripts/build-terminal-assets.mjs",
    "pixelate-image": "node scripts/pixelate-image.mjs",
    "test:unit": "node --test tests/scripts/terminal-assets.test.mjs",
    "predev": "npm run build-terminal-assets",
    "prebuild": "npm run build-terminal-assets",
    "prepreview": "npm run build-terminal-assets",
    "build": "astro build",
    "check": "tsc --noEmit && biome check src tests playwright.config.ts astro.config.js",
    "dev": "astro dev",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "lint-and-format": "npx @biomejs/biome check --write --unsafe",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "generate-types": "wrangler types",
    "cf-preview": "astro build && wrangler dev",
    "cf-deploy": "astro build && wrangler deploy"
  },
  "keywords": [
    "terminal",
    "xterm",
    "crt",
    "retro",
    "webgl",
    "three.js",
    "cool-retro-term"
  ],
  "author": "Adam Burmister",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/adamburmister/burmister.com"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^14.1.2",
    "@astrojs/sitemap": "^3.7.3",
    "@biomejs/biome": "^2.5.3",
    "@playwright/test": "^1.61.1",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.185.1",
    "astro": "^7.0.7",
    "node-addon-api": "^8.9.0",
    "node-gyp": "^13.0.1",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.110.0"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/stats.js": "^0.17.4",
    "@xterm/xterm": "^6.0.0",
    "cool-retro-term-renderer": "^1.0.1"
  }
}
