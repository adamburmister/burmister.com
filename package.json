  "repository": {
    "type": "git",
    "url": "https://github.com/adamburmister/burmister.com"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^13.3.1",
    "@astrojs/sitemap": "^3.7.2",
    "@biomejs/biome": "^2.3.10",
    "@types/three": "^0.182.0",
    "astro": "^6.2.2",
    "node-addon-api": "^8.5.0",
    "node-gyp": "^12.1.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.40.2"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/stats.js": "^0.17.4",
