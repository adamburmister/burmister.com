{
  "name": "burmister-com",
  "version": "1.0.0",
  "description": "Adam Burmister's retro terminal CV and portfolio website",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "lint-and-format": "npx @biomejs/biome check --write --unsafe",
    "test": "echo \"Error: no test specified\" && exit 1",
    "generate-types": "wrangler types",
    "cf-preview": "astro build && wrangler dev",
    "cf-deploy": "astro build && wrangler deploy"
  },
  "keywords": [
    "terminal",
    "xterm",
    "crt",
    "retro",
    "webgl",
    "three.js",
    "cool-retro-term"
